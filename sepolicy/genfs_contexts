# PMIC power supplies (qpnp-bms: fuel gauge, qpnp-charger: battery/dc,
# msm_otg: usb), read by healthd/charger and the health HAL. On the 930 the
# Qi wireless charger should feed the PM8941 DC input ("dc" supply).
# TODO: the -10/-14 suffixes are the 1520 platform device numbers; check
# them on the 930 (ls /sys/devices | grep qpnp) and the Qi path.
genfscon sysfs /devices/qpnp-bms-10/power_supply        u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/qpnp-charger-14/power_supply    u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/msm_otg/power_supply            u:object_r:sysfs_batteryinfo:s0

# Sensor chips and their input devices (enable, poll_delay): sysfs_sensors,
# read and written by the sensors HAL (in system_server, passthrough).
# APDS-9930 (BLSP1 I2C3 0x39; bus number unverified, see ueventd). TODO:
# accelerometer, gyroscope and magnetometer once known.
genfscon sysfs /devices/f9925000.i2c/i2c-4/4-0039       u:object_r:sysfs_sensors:s0
genfscon sysfs /devices/f9924000.i2c/i2c-2/2-004b/0dbutton u:object_r:sysfs_touchpanel:s0
genfscon sysfs /devices/f9924000.i2c/i2c-2/2-004b/wake_gesture u:object_r:sysfs_touchpanel:s0

# Adreno 330 (kgsl): sepolicy-legacy labels it only under /sys/devices/soc,
# which this 3.4 kernel does not have. Written by the power HAL (min_pwrlevel)
# and thermal-engine (max_gpuclk).
genfscon sysfs /devices/fdb00000.qcom,kgsl-3d0/kgsl/kgsl-3d0 u:object_r:sysfs_kgsl:s0

# Modem start gate (boot_enabled, max_attempts, attempts), written by init
# for persist.vendor.martini.modem (init.martini.qcom.rc)
genfscon sysfs /module/pil_q6v5_mss/parameters u:object_r:sysfs_pil_mss:s0

# hci_qcomm_init waits for the WCNSS SMD channel before attaching Bluetooth
# (1520 denial: bluetooth_loader reading plain sysfs smd_channel_ready)
genfscon sysfs /devices/fb000000.qcom,wcnss-wlan/smd_channel_ready u:object_r:sysfs_wcnss_smd:s0

# FM radio: the iris SMD transport switch, written by init.martini.fm.sh
# (qti_init_shell, which sepolicy-legacy allows on sysfs_fm). sepolicy-legacy
# labels it in file_contexts, but nothing relabels /sys/module: ueventd only
# restores /sys/class, /sys/block and /sys/devices at cold boot.
genfscon sysfs /module/radio_iris_transport/parameters/fmsmd_set u:object_r:sysfs_fm:s0

# zram swap tuning in init.martini.rc (written by vendor_init)
genfscon proc /sys/vm/swappiness u:object_r:proc_swappiness:s0
