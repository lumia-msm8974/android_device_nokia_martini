# Vibrator HAL of the 930 (vibrator/): the motor is fed from the audio codec,
# so the HAL plays PCM on MultiMedia9 and sets the codec route through the
# mixer. Only audio HAL servers may open /dev/snd (system/sepolicy
# hal_audio.te), hence the second server attribute.
type hal_vibrator_martini, domain;
type hal_vibrator_martini_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_vibrator_martini)

hal_server_domain(hal_vibrator_martini, hal_vibrator)
hal_server_domain(hal_vibrator_martini, hal_audio)

# Waveform and route tuning (persist.vendor.vibra.*)
get_prop(hal_vibrator_martini, vendor_default_prop)
