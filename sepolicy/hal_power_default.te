# Double tap to wake: the power HAL writes the touch driver's wake_gesture
allow hal_power_default sysfs_touchpanel:file rw_file_perms;
# Perf locks (libmartini-perflock): cpufreq limits and interactive governor
allow hal_power_default sysfs_devices_system_cpu:dir r_dir_perms;
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
