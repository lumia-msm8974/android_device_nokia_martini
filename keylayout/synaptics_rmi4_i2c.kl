# Lumia 930 capacitive keys (Synaptics F1A 0D buttons): back, start (home),
# search (app switch). The Windows touch settings of the 930 list the same
# three buttons as the 1520 (Back, Start, Search, same FF button order), and
# the kernel DT maps them as on the 1520. The touch driver keeps 8-bit key
# codes, so search arrives as KEY_MENU (139). Unverified on the phone.
key 158   BACK        VIRTUAL
key 172   HOME        VIRTUAL
key 139   APP_SWITCH  VIRTUAL

# Double tap on the screen while it is off (touch firmware wakeup gesture)
key 143   WAKEUP
