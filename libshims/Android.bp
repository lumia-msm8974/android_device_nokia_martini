// From device/oppo/msm8974-common/libshims: the Qualcomm RIL blob
// (libril-qc-qmi-1.so) still calls AudioSystem::setErrorCallback.
cc_library_shared {
    name: "libaudioclient_shim",
    srcs: ["libaudioclient_shim.cpp"],
    shared_libs: ["libaudioclient"],
    vendor: true,
}

// hci_qcomm_init asks the (not running) modem for the Bluetooth address
// over QMI and waits about 60 s; the stack closes the HAL earlier and the
// AOSP 1.0 HAL aborts. Preloaded only for hci_qcomm_init by init.qcom.bt.sh.
cc_library_shared {
    name: "libbtqmishim",
    srcs: ["btqmishim.c"],
    vendor: true,
}

// The gyro module of mm-qcamera-daemon waits about 3 s for the SSC sensor
// socket at every camera open; with SSC off, fail at once. Preloaded only
// for mm-qcamera-daemon (init.martini.qcom.rc).
cc_library_shared {
    name: "libsensor1shim",
    srcs: ["sensor1shim.c"],
    shared_libs: ["libdl"],
    vendor: true,
}
