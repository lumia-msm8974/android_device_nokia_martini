// PN544 HAL for the legacy NXP NFC stack. It is loaded by libnfc and
// libnfc_jni in the Nfc app process, so it lives in /system/lib/hw.
cc_library_shared {
    name: "nfc.martini",
    relative_install_path: "hw",
    srcs: ["nfc_hw.c"],
    cflags: ["-Wall", "-Werror"],
    header_libs: ["libhardware_headers"],
}
