// Lights HAL: display backlight only (AMOLED panel brightness through the
// MDSS lcd-backlight device). The Lumia 930 has no key backlight and no
// notification LED.
cc_library_shared {
    name: "lights.msm8974",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["lights.c"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    header_libs: ["libhardware_headers"],
    cflags: ["-Wall", "-Werror"],
}
