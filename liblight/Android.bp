// Lights HAL: LCD backlight and the capacitive key backlight (PM8941
// KPDBL). The Lumia 1520 has no notification LED.
cc_library_shared {
    name: "lights.msm8974",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["lights.c"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    header_libs: ["libhardware_headers"],
    cflags: ["-Wall", "-Werror"],
}
