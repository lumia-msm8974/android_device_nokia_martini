#
# Power settings for the Lumia 930, from the Lumia 1520 (bandit) ones and
# device/oppo/msm8974-common init.qcom.power.rc. The Windows Phone TrustZone has no power collapse and
# resets the SoC when secondary cores are started through SCM, so this file
# never enables msm_pm power collapse modes, never touches cpu1-3 online
# state and never starts mpdecision. The kernel starts cores 1-3 at boot
# through the UEFI parking protocol, refuses CPU hotplug and idles in WFI.
# The kernel leaves their clocks as the firmware set them at boot, but once
# the cores run, cpufreq scales them like cpu0 (tested on the 1520 from
# 300 MHz to 2.15 GHz; TODO: repeat the test on the 930),
# so every core gets the same governor as on the OnePlus One.

on early-init
    write /sys/block/mmcblk0/bdi/read_ahead_kb 512
    # eMMC requests do not feed the entropy pool: less work per request,
    # the pool has other sources
    write /sys/block/mmcblk0/queue/add_random 0

on boot
    # Double tap to wake switch, written by the power HAL (user system).
    # Same path as on the 1520 (i2c-2, 0x4b); unverified on the 930.
    chown system system /sys/devices/f9924000.i2c/i2c-2/2-004b/wake_gesture
    chmod 0660 /sys/devices/f9924000.i2c/i2c-2/2-004b/wake_gesture

    # The vendor.perflock.base.* values are the baselines libmartini-perflock
    # restores when the power HAL starts (perf/perflock.c): keep them equal
    # to the governor values written next to them.
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "interactive"
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor "interactive"
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor "interactive"
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor "interactive"
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay "19000 1400000:39000 1700000:19000"
    write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 90
    setprop vendor.perflock.base.go_hispeed_load 90
    write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 1190400
    setprop vendor.perflock.base.hispeed_freq 1190400
    write /sys/devices/system/cpu/cpufreq/interactive/io_is_busy 1
    setprop vendor.perflock.base.io_is_busy 1
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "85 1500000:90 1800000:70"
    write /sys/devices/system/cpu/cpufreq/interactive/min_sample_time 40000
    write /sys/devices/system/cpu/cpufreq/interactive/sampling_down_factor 100000
    write /sys/devices/system/cpu/cpufreq/interactive/timer_rate 30000
    setprop vendor.perflock.base.timer_rate 30000
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_min_freq 300000

    write /sys/module/cpu_boost/parameters/boost_ms 20
    write /sys/module/cpu_boost/parameters/sync_threshold 1728000
    write /sys/module/cpu_boost/parameters/input_boost_freq 1497600
    write /sys/module/cpu_boost/parameters/input_boost_ms 40

    # CPU bandwidth (cpubw) governor: set after boot by init.martini.power.sh,
    # whatever the qcom,cpubw.<N> number of the devfreq node (40 on the
    # OnePlus One, 41 on the 1520). GPU: msm-adreno-tz is the kernel's
    # default governor and decides in the kernel (no TrustZone DCVS calls
    # on the Windows Phone TrustZone); the power HAL only raises its floor
    # (min_pwrlevel, below).

    # Perf locks of the power HAL (libmartini-perflock, running as system):
    # interaction, launch, display and profile boosts move these values,
    # as mpdecision does as root on the OnePlus One.
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpu1/cpufreq/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpu2/cpufreq/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpu3/cpufreq/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpu1/cpufreq/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpu2/cpufreq/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpu3/cpufreq/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/interactive/timer_rate
    chown system system /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq
    chown system system /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load
    chown system system /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
    # GPU floor during interaction, fling and launch boosts (389 MHz by
    # default, persist.vendor.perflock.gpu_floor_mhz, 0 = off); the
    # thermal limit (max_gpuclk, thermal-engine) stays above it in kgsl.
    chown system system /sys/class/kgsl/kgsl-3d0/min_pwrlevel

on charger
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "powersave"
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor "powersave"
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor "powersave"
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor "powersave"
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_min_freq 300000

on fs
    wait /dev/block/platform/msm_sdcc.1
    symlink /dev/block/platform/msm_sdcc.1 /dev/block/bootdevice
    setprop sys.usb.ffs.aio_compat 1
    setprop persist.adb.nonblocking_ffs 0
    setprop ro.adb.nonblocking_ffs 0
    setprop sys.usb.mtp.device_type 2

on property:recovery.perf.mode=1
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "performance"
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor "performance"
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor "performance"
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor "performance"

on property:recovery.perf.mode=0
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "interactive"
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor "interactive"
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor "interactive"
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor "interactive"

# Late, so that a problem of the Krait L2 monitor behind cpubw_hwmon leaves
# time to setprop persist.vendor.martini.cpubw_hwmon 0 over adb.
on property:sys.boot_completed=1 && property:persist.vendor.martini.cpubw_hwmon=1
    exec - root root -- /vendor/bin/init.martini.power.sh

on property:dev.bootcomplete=1
    setprop sys.io.scheduler "bfq"
    setprop vendor.post_boot.parsed 1
