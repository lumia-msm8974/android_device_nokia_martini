# Nokia Lumia 930 (martini) - provisional fstab.
# Android partitions do not exist on the stock Windows Phone GPT: they are
# created inside the space of Data with the same layout as on the Lumia 1520
# (installer partition.sh/provision.sh, martini profile still to be written;
# TODO: check it against the 930 GPT, 32 GB eMMC). Every name must be
# unique: a second "userdata" (as reported by the LineageOS 17.1 martini
# port) makes by-name/userdata ambiguous. Partitions: aboot, boot,
# recovery, misc, modem, cache,
# persist, persistent, fsc, fsg, metadata, ssd, modemst1, modemst2, vendor,
# system, userdata. modem is a FAT image with the remote processor firmware
# (also shipped in /vendor/firmware from the vendor's local folder);
# modemst1/2, fsc, fsg and ssd are copies of the Windows MODEM_FS*/SSD
# partitions used by rmt_storage.

#<src>                                              <mnt_point>     <type>  <mnt_flags and options>                                         <fs_mgr_flags>
/dev/block/platform/msm_sdcc.1/by-name/userdata     /data           ext4    noatime,nosuid,nodev,barrier=1,data=ordered,noauto_da_alloc,errors=panic wait,check,formattable,latemount
/dev/block/platform/msm_sdcc.1/by-name/cache        /cache          ext4    noatime,nosuid,nodev,barrier=1,data=ordered,noauto_da_alloc,errors=panic wait,check,formattable
/dev/block/platform/msm_sdcc.1/by-name/persist      /persist        ext4    nosuid,nodev,barrier=1,data=ordered,nodelalloc,errors=panic wait,check,notrim
/dev/block/platform/msm_sdcc.1/by-name/DPP          /mnt/vendor/dpp vfat    ro,nosuid,nodev,noexec,shortname=lower,uid=0,gid=0,dmask=0277,fmask=0377,context=u:object_r:martini_dpp_file:s0 wait,nofail
/dev/block/platform/msm_sdcc.1/by-name/modem        /firmware       vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait
/dev/block/platform/msm_sdcc.1/by-name/boot         /boot           emmc    defaults                                                        defaults
/dev/block/platform/msm_sdcc.1/by-name/recovery     /recovery       emmc    defaults                                                        defaults
/dev/block/platform/msm_sdcc.1/by-name/misc         /misc           emmc    defaults                                                        defaults
/dev/block/platform/msm_sdcc.1/by-name/aboot        /aboot          emmc    defaults                                                        defaults
/dev/block/platform/msm_sdcc.1/by-name/persistent   /persistent     emmc    defaults                                                        defaults

# Compressed swap in RAM (zram, LZ4): 512 MB, about a third of the usable RAM;
# one compression stream per core (all four cores run since SMP)
/dev/block/zram0                                    none            swap    defaults                                                        zramsize=536870912,max_comp_streams=4

# No microSD slot on the Lumia 930
