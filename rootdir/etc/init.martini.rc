# Nokia Lumia 930 (martini)

import /vendor/etc/init/hw/init.martini.qcom.rc

on fs
    # Windows provisioning partition, read-only (init.martini.wifi.sh)
    mkdir /mnt/vendor/dpp 0500 root root
    mount_all /vendor/etc/fstab.martini --early
    start hwservicemanager

on late-fs
    start hwservicemanager
    start servicemanager
    start surfaceflinger
    start configstore-hal-1-0
    start gralloc-2-0
    mount_all /vendor/etc/fstab.martini --late

# Factory reset protection: the persistent partition node is owned by system
# in ueventd.martini.rc

on boot
    # zram swap (fstab.martini), LZ4 is cheaper than LZO on one Krait core
    write /sys/block/zram0/comp_algorithm lz4
    swapon_all /vendor/etc/fstab.martini
    # The only swap is zram: swap anonymous pages as readily as file pages
    # are dropped, one page at a time (no read-ahead on a RAM device)
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/page-cluster 0

# No serial console on the Lumia 930 (as on the 1520): /dev/console is only
# the kernel's
# empty virtual terminal, but the userdebug "console" shell kept running and
# Android showed the "serial console enabled" performance notification.
on property:init.svc.console=running
    stop console

# Bring-up boot log (init.martini.bootlog.sh), on when
# persist.vendor.martini.bootlog=1 (set on non-user builds by device.mk).
# TODO: off for releases.
service vendor.martini_bootlog /vendor/bin/init.martini.bootlog.sh
    class late_start
    user root
    group root log
    disabled
    oneshot

on post-fs-data && property:persist.vendor.martini.bootlog=1
    mkdir /data/vendor/bootlog 0750 root root
    start vendor.martini_bootlog
