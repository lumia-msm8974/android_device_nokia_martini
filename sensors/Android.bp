// Sensors HAL on the martini-* input devices of the kernel drivers
// (accelerometer, magnetometer, gyroscope, light, proximity). Loaded by
// android.hardware.sensors@1.0-impl: ro.hardware=martini makes it win over
// the Qualcomm ADSP HAL (sensors.msm8974).
cc_library_shared {
    name: "sensors.martini",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["sensors.c"],
    shared_libs: [
        "liblog",
    ],
    header_libs: ["libhardware_headers"],
    cflags: ["-Wall", "-Werror"],
}
