diff --git a/app/src/main/java/me/phh/sip/PlatformCompat.kt b/app/src/main/java/me/phh/sip/PlatformCompat.kt
new file mode 100644
index 0000000..ce650d5
--- /dev/null
+++ b/app/src/main/java/me/phh/sip/PlatformCompat.kt
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0
+package me.phh.sip
+
+import android.content.Context
+import android.os.Build
+import android.telephony.NetworkRegistrationInfo
+import android.telephony.ServiceState
+import android.telephony.SmsManager
+import android.telephony.SubscriptionManager
+import android.telephony.ims.ImsCallSessionListener
+import android.telephony.ims.ImsReasonInfo
+
+// Android 11 (API 30) replacements for the Android 12-13 APIs used by the
+// stack. Each helper keeps the newer API on the releases that have it.
+
+val phhAtLeastS: Boolean
+    get() = Build.VERSION.SDK_INT >= Build.VERSION_CODES.S
+
+private val phhAtLeastT: Boolean
+    get() = Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU
+
+// NetworkRegistrationInfo.isNetworkRegistered() is Android 13; isRegistered()
+// (HOME or ROAMING) has the same meaning on the older releases.
+val NetworkRegistrationInfo.phhNetworkRegistered: Boolean
+    get() = if (phhAtLeastT) isNetworkRegistered else isRegistered
+
+// Registered PLMN of the first registration that reports one. With the
+// Android 11 legacy RIL the cell identity often has no MCC/MNC, so the
+// registered PLMN stays empty: fall back to the operator numeric of the
+// service state, which comes from the OPERATOR request.
+fun ServiceState.phhRegisteredPlmn(): String? {
+    val fromRegistration = networkRegistrationInfoList
+        .firstOrNull { !it.registeredPlmn.isNullOrEmpty() }
+        ?.registeredPlmn
+    if (fromRegistration != null) return fromRegistration
+    if (phhAtLeastS) return null
+    return operatorNumeric?.takeIf { it.length >= 5 && it.all(Char::isDigit) }
+}
+
+// SubscriptionManager.getSubscriptionId(slot) is Android 13.
+fun phhSubscriptionIdForSlot(slotId: Int): Int {
+    if (phhAtLeastT) return SubscriptionManager.getSubscriptionId(slotId)
+    return SubscriptionManager.getSubId(slotId)?.firstOrNull()
+        ?: SubscriptionManager.INVALID_SUBSCRIPTION_ID
+}
+
+// SmsManager.createForSubscriptionId() is Android 12.
+@Suppress("DEPRECATION")
+fun phhSmsManagerFor(context: Context, subId: Int): SmsManager =
+    if (phhAtLeastS) {
+        context.getSystemService(SmsManager::class.java).createForSubscriptionId(subId)
+    } else {
+        SmsManager.getSmsManagerForSubscriptionId(subId)
+    }
+
+// callSessionInitiatingFailed() is Android 12; Android 11 reports a failed
+// start through callSessionInitiatedFailed().
+@Suppress("DEPRECATION")
+fun ImsCallSessionListener.phhInitiatingFailed(reasonInfo: ImsReasonInfo) {
+    if (phhAtLeastS) {
+        callSessionInitiatingFailed(reasonInfo)
+    } else {
+        callSessionInitiatedFailed(reasonInfo)
+    }
+}
