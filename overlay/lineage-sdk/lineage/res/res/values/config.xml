<resources>
    <!-- Capacitive keys: back (2), home (1), app switch (16); volume rocker
         (64) on the PM8941 GPIOs. The camera bit (32) stays off: LumiaParts
         owns that button, and LineageParts would show settings with no effect -->
    <integer name="config_deviceHardwareKeys">83</integer>

    <!-- Variable key backlight: the PM8941 KPDBL rows, as on the 1520 (stock
         DSDT HWN LED device and NOKIA_PANEL key light groups of the 930) -->
    <integer name="config_deviceSupportsButtonBrightnessControl">2</integer>

    <!-- Camera button actions (LumiaParts) -->
    <string-array name="config_deviceKeyHandlerLibs" translatable="false">
        <item>/system/system_ext/framework/LumiaKeyHandler.jar</item>
    </string-array>
    <string-array name="config_deviceKeyHandlerClasses" translatable="false">
        <item>org.lineageos.lumia.keyhandler.KeyHandler</item>
    </string-array>
</resources>
