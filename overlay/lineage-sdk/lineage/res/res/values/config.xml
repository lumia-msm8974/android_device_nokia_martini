<resources>
    <!-- Capacitive keys: back (2), home (1), app switch (16); camera (32)
         and volume rocker (64) on the PM8941 GPIOs -->
    <integer name="config_deviceHardwareKeys">115</integer>

    <!-- Key backlight: three LEDs under the keys (Windows touch settings:
         ButtonBacklights LedCount 3), driven on the 1520 by the PM8941 KPDBL
         rows. The martini kernel keeps KPDBL off until the 930 ACPI tables
         confirm the rows, so no brightness control for now.
         TODO: set to 2 (variable) together with the kernel KPDBL node; the
         lights HAL already drives kpdbl-pwm-1..4 when they exist. -->
    <integer name="config_deviceSupportsButtonBrightnessControl">0</integer>

    <!-- No Oppo ConfigPanel / touchscreen gesture key handlers -->
    <string-array name="config_deviceKeyHandlerLibs" translatable="false" />
    <string-array name="config_deviceKeyHandlerClasses" translatable="false" />
</resources>
