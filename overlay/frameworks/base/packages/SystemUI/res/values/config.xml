<resources>
    <!-- Always-on display through the display DOZE state: the hwcomposer
         maps it to FB_BLANK_NORMAL and the martini kernel (MDSS video mode
         doze) keeps the MDP streaming, puts the AMOLED panel in DCS idle
         mode (the Windows Glance screen sequence) and keeps the system out
         of suspend, which would stop the frames. Without this, always-on
         display is a normal screen on at the doze brightness. -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- No DOZE_SUSPEND: a video mode panel has no frame memory, the kernel
         treats it as screen off. SystemUI asks DOZE instead. -->
    <bool name="doze_suspend_display_state_supported">false</bool>
</resources>
