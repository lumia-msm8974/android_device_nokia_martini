<!-- Lumia 930 values that replace the Oppo ones of msm8974-common. -->
<resources>
    <!-- Device idle: no motion sensor yet (the 930 accelerometer is behind the
         ADSP sensor core, not supported yet), so deep idle must not wait for
         one. TODO: back to the default once the SSC sensors work. -->
    <bool name="config_autoPowerModeUseMotionSensor">false</bool>

    <!-- No wallpaper zoom: one less full-screen scale per frame on the
         Adreno 330 -->
    <item name="config_wallpaperMaxScale" format="float" type="dimen">1</item>

    <!-- No flip cover sensor -->
    <bool name="config_lidControlsSleep">false</bool>

    <!-- Double tap to wake: the touch firmware's wakeup gesture, switched
         by the power HAL (TARGET_TAP_TO_WAKE_NODE) -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- No notification LED -->
    <bool name="config_intrusiveNotificationLed">false</bool>

    <!-- Capacitive keys (Back, Start, Search below the panel) by default;
         enabling the navigation bar or gestures in LineageOS turns the keys
         off through the key disabler. -->
    <bool name="config_showNavigationBar">false</bool>

    <!-- Automatic brightness from the APDS-9930 ambient light sensor (kernel
         calibration scaled from the 1520 by the Windows coefficients). -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Ambient light thresholds (lux): the breakpoints of the lux to nits
         table of the 930 Windows panel driver (registry NOKIA_PANEL
         Parameters\Settings, LIGHT_LuxToNitD_LuxIn1-9). -->
    <integer-array name="config_autoBrightnessLevels">
        <item>2</item>
        <item>10</item>
        <item>40</item>
        <item>100</item>
        <item>250</item>
        <item>500</item>
        <item>1000</item>
        <item>3500</item>
        <item>15000</item>
    </integer-array>

    <!-- Backlight (DCS 0x51, 0-255) for each lux range: the nits of the same
         table (LIGHT_LuxToNitD_NitOut0-9: 22, 35, 60, 85, 120, 165, 200,
         250, 325, 400; 600 and 800 nits above 50000 lux; the generic
         oempanel.inf defaults differ), assuming the panel is about linear
         in nits and reaches 400 nits at 255 like the 950 XL AMOLED; the
         levels above 400 nits (outdoor boost) are clamped to 255.
         TODO: measure the panel luminance on the phone. -->
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>14</item>   <!-- 0-2 -->
        <item>22</item>   <!-- 2-10 -->
        <item>38</item>   <!-- 10-40 -->
        <item>54</item>   <!-- 40-100 -->
        <item>76</item>   <!-- 100-250 -->
        <item>105</item>  <!-- 250-500 -->
        <item>128</item>  <!-- 500-1000 -->
        <item>159</item>  <!-- 1000-3500 -->
        <item>207</item>  <!-- 3500-15000 -->
        <item>255</item>  <!-- 15000+ -->
    </integer-array>

    <!-- Ambient display and always-on display (Glance-like). The AMOLED
         panel only lights the pixels drawn, which suits always-on, but it is
         a DSI video mode panel: the MDP must keep streaming frames, there is
         no command mode low power state. Always-on stays off by default.
         TODO: check doze power draw and the panel's idle mode on the 930. -->
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>
    <integer name="config_screenBrightnessDoze">17</integer>
</resources>
